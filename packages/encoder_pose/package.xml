<?xml version="1.0"?>
<package format="3">
  <name>encoder_pose</name>
  <version>2.0.0</version>
  <description>Pose estimation (dead reckoning) of the Duckiebot from the wheel encoders.</description>
  <maintainer email="info@duckietown.com">Duckietown</maintainer>
  <license>Duckietown License 2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>duckietown_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>lx_ros2_tools</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
